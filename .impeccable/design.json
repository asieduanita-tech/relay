  "narrative": {
    "northStar": "The Partner Research Brief",
    "overview": "Relay presents partner intelligence as a contemporary editorial research brief inside a working operations tool. A deep forest rail anchors a warm near-white workspace; restrained containers and aligned tables keep evidence readable.\n\nInter carries the work and Newsreader provides editorial page titles. Density serves repeated scanning, while exact quotations, explicit status labels and visible provenance support careful review. Synthetic examples and unavailable live analysis remain clearly disclosed.",
    "keyCharacteristics": [
      "Forest navigation with a quiet, near-white workspace.",
      "Editorial titles and practical, compact work typography.",
      "Flat surfaces, fine borders and restrained semantic color.",
      "Evidence, provenance and human review remain visible."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "Keep quotations, source context and review status legible beside the decisions they support.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Separate content with tone, spacing and fine borders; the implemented interface uses no elevation shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use Inter for working text and Newsreader for editorial titles.",
      "Do pair semantic colors with written status labels.",
      "Do preserve visible focus, explicit form labels and scrollable dense tables.",
      "Do disclose precomputed synthetic examples and that new imports are saved without live AI analysis."
    ],
    "donts": [
      "Don't imply synthetic findings are live model results.",
      "Don't replace source quotations or provenance with decorative summaries.",
      "Don't introduce decorative elevation or imagery into the restrained operations workspace."
    ]
  }
}
